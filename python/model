import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LogisticRegression
from sklearn.tree import DecisionTreeClassifier
from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score

# 1. โหลดข้อมูล 
df = pd.read_csv('path') #เปลี่ยน path data
X = df.drop('Churn', axis=1)
y = df['Churn']

# 2. แบ่งข้อมูล Train/Test
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2, random_state=1)

# 3. สเกลข้อมูล (Standardization)
scaler = StandardScaler()
cols_to_scale = ['tenure', 'MonthlyCharges', 'TotalCharges']
X_train_scaled = X_train.copy()
X_test_scaled = X_test.copy()
X_train_scaled[cols_to_scale] = scaler.fit_transform(X_train[cols_to_scale])
X_test_scaled[cols_to_scale] = scaler.transform(X_test[cols_to_scale])

# 4. เทรนโมเดล Logistic Regression
logreg = LogisticRegression(max_iter=1000, random_state=1)
logreg.fit(X_train_scaled, y_train)
y_pred_logreg = logreg.predict(X_test_scaled)

# 5. เทรนโมเดล Decision Tree
dt = DecisionTreeClassifier(max_depth=5, random_state=1)
dt.fit(X_train, y_train)
y_pred_dt = dt.predict(X_test)

# 6. ฟังก์ชันสำหรับคำนวณและประเมินผล
def get_metrics(y_true, y_pred):
    return [
        accuracy_score(y_true, y_pred),
        precision_score(y_true, y_pred),
        recall_score(y_true, y_pred),
        f1_score(y_true, y_pred)
    ]

metrics_logreg = get_metrics(y_test, y_pred_logreg)
metrics_dt = get_metrics(y_test, y_pred_dt)
metric_names = ['1. Accuracy', '2. Precision', '3. Recall', '4. F1-Score']

# 7. แสดงผลลัพธ์เปรียบเทียบ
print(f"{'ตัวชี้วัด      ':<20} | {'Logistic Regression':<20} | {'Decision Tree':<15}")

for i in range(4):
    print(f"{metric_names[i]:<20} | {metrics_logreg[i]*100:>18.2f}% | {metrics_dt[i]*100:>13.2f}%")
